{
  "name": "live-translate",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests --max-warnings=0",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.mjs",
    "coverage": "node --import tsx --test --experimental-test-coverage --test-coverage-lines=90 --test-coverage-branches=75 --test-coverage-functions=80 tests/*.test.ts",
    "bundle": "node build.mjs",
    "server": "node --env-file=.env.local server/live-server.mjs",
    "build": "npm run typecheck && npm run bundle",
    "check": "npm run typecheck && npm run lint && npm run test && npm run coverage && npm run bundle && npm audit --audit-level=moderate",
    "macos:test": "swift test --package-path macos",
    "macos:build": "node scripts/build-macos.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.280",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "tsx": "^4.23.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.65.0"
  },
  "dependencies": {
    "onnxruntime-web": "1.30.0"
  }
}
